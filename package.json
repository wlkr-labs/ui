{
  "name": "wlkr-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm registry:build && next build && node scripts/build-info.mjs",
    "start": "wrangler dev --local --ip 127.0.0.1",
    "lint": "eslint .",
    "registry:build": "shadcn build && node scripts/registry-catalog.mjs",
    "typecheck": "tsc --noEmit",
    "release:check": "node scripts/release-check.mjs",
    "deploy:check": "pnpm build && wrangler deploy --dry-run",
    "deploy": "pnpm release:check && wrangler deploy"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^0.487.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20.19.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "16.4.2",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "wrangler": "4.145.0"
  },
  "packageManager": "pnpm@11.15.0"
}
